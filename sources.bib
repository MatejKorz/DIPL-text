@inproceedings{rogaway_efficient_2004,
	location = {Berlin, Heidelberg},
	title = {Efficient Instantiations of Tweakable Blockciphers and Refinements to Modes {OCB} and {PMAC}},
	isbn = {9783540305392},
	doi = {10.1007/978-3-540-30539-2_2},
	abstract = {We describe highly efficient constructions, {XE} and {XEX}, that turn a blockcipher \$E: {\textbackslash}mathcal\{K\} {\textbackslash}times {\textbackslash}\{0, 1 {\textbackslash}\}{\textasciicircum}\{n\} {\textbackslash}rightarrow {\textbackslash}\{0, 1 {\textbackslash}\}{\textasciicircum}\{n\}\$into a tweakable blockcipher \$\{E\}: {\textbackslash}mathcal\{K\} {\textbackslash}times {\textbackslash}mathcal\{T\} {\textbackslash}times {\textbackslash}\{0, 1 {\textbackslash}\}{\textasciicircum}\{n\} {\textbackslash}rightarrow {\textbackslash}\{0, 1 {\textbackslash}\}{\textasciicircum}\{n\}\$having tweak space \${\textbackslash}mathcal\{T\} = {\textbackslash}\{0, 1 {\textbackslash}\}{\textasciicircum}\{n\} {\textbackslash}times {\textbackslash}mathbb\{I\}\$where \${\textbackslash}mathbb\{I\}\$is a set of tuples of integers such as \${\textbackslash}mathbb\{I\} = [..2{\textasciicircum}\{n/2\}] {\textbackslash}times [0..10]\$. When tweak T is obtained from tweak S by incrementing one if its numerical components, the cost to compute \$\{E\}{\textasciicircum}\{T\}\_\{K\}(M)\$having already computed some \$\{E\}{\textasciicircum}\{S\}\_\{K\}(M')\$is one blockcipher call plus a small and constant number of elementary machine operations. Our constructions work by associating to the ithcoordinate of \${\textbackslash}mathbb\{I\}\$an element \${\textbackslash}alpha\_\{i\} {\textbackslash}epsilon {\textbackslash}mathbb\{F\}{\textasciicircum}\{*\}\_\{2\}n\$and multiplying by αiwhen one increments that component of the tweak. We illustrate the use of this approach by refining the authenticated-encryption scheme {OCB} and the message authentication code {PMAC}, yielding variants of these algorithms that are simpler and faster than the original schemes, and yet have simpler proofs. Our results bolster the thesis of Liskov, Rivest, and Wagner [10] that a desirable approach for designing modes of operation is to start from a tweakable blockcipher. We elaborate on their idea, suggesting the kind of tweak space, usage-discipline, and blockcipher-based instantiations that give rise to simple and efficient modes.},
	pages = {16--31},
	booktitle = {Advances in Cryptology - {ASIACRYPT} 2004},
	publisher = {Springer},
	author = {Rogaway, Phillip},
	editor = {Lee, Pil Joong},
	date = {2004},
	langid = {english},
	keywords = {Block Cipher, Message Authentication Code, Oracle Query, Primitive Polynomial, Unique Representation},
}

@inproceedings{liskov_tweakable_2002,
	location = {Berlin, Heidelberg},
	title = {Tweakable Block Ciphers},
	isbn = {9783540457084},
	doi = {10.1007/3-540-45708-9_3},
	abstract = {We propose a new cryptographic primitive, the “tweakable block cipher.” Such a cipher has not only the usual inputs — message and cryptographic key — but also a third input, the “tweak.” The tweak serves much the same purpose that an initialization vector does for {CBC} mode or that a nonce does for {OCB} mode. Our proposal thus brings this feature down to the primitive block-cipher level, instead of incorporating it only at the higher modes-of-operation levels. We suggest that (1) tweakable block ciphers are easy to design, (2) the extra cost of making a block cipher “tweakable” is small, and (3) it is easier to design and prove modes of operation based on tweakable block ciphers.},
	pages = {31--46},
	booktitle = {Advances in Cryptology — {CRYPTO} 2002},
	publisher = {Springer},
	author = {Liskov, Moses and Rivest, Ronald L. and Wagner, David},
	editor = {Yung, Moti},
	date = {2002},
	langid = {english},
	keywords = {block ciphers, initialization vector, modes of operation, tweakable block ciphers},
}

